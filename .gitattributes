* text=auto
*.png binary
*.ico binary
*.ptx binary

# Preserve pinned byte hashes across Windows checkouts.
/desktop/native/ysr/** -text
/desktop/experiments/yskar/upstream/** -text
*.exe binary
*.wasm binary

# Linux entry points and generated CUDA source must retain release bytes.
/desktop/experiments/midstate/linux/** text eol=lf
/desktop/experiments/midstate/cuda/** -text
